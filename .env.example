# --- LLM credentials --------------------------------------------------------
# The default routing uses both providers. An empty key counts as "not set".
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Model routing overrides (all optional) ---------------------------------
# Roles are defined in src/ticketideai/config/models.yaml: planner, responder, judge.
# MODEL__PLANNER=
# MODEL__RESPONDER=
# MODEL__JUDGE=
# LLM_PROVIDER=
# ANTHROPIC_MODEL=
# OPENAI_MODEL=
# Low-cost profile: src/ticketideai/config/models.budget.yaml
# MODELS_CONFIG_PATH=

# --- Store ------------------------------------------------------------------
# SQLite path or sqlite:/// URL. Blank uses data/ticketide.sqlite.
# DATABASE_URL=
# Fixed "today" for the seeded demo store, so its return windows stay valid: 2026-11-17
STORE_AS_OF=

# --- Transport --------------------------------------------------------------
# LLM_TIMEOUT_SECONDS=
# LLM_MAX_RETRIES=

# --- Observability (optional) -----------------------------------------------
# Tracing is enabled only when both keys are set.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# LANGFUSE_BASE_URL=

# --- Logging ----------------------------------------------------------------
# LOG_LEVEL=
